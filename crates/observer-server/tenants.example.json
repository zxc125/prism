      "scrubbers": [
        "Bearer\\s+[\\w.-]+",
        "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+"
      ]
    },
    "rateLimit": { "maxRpm": 600 }
  },
  {
    "key": "sk_beta_dev",
    "tenantId": "beta",
    "appIds": [],
    "retention": { "maxSessions": 200 }
  }
]
